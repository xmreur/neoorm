{
	"name": "neoorm",
	"version": "0.8.5",
	"description": "TypeScript-first PostgreSQL, SQLite, MySQL, and MariaDB ORM with schema DSL, codegen, and typed relations",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xmreur/neoorm.git"
	},
	"bugs": {
		"url": "https://github.com/xmreur/neoorm/issues"
	},
	"homepage": "https://github.com/xmreur/neoorm#readme",
	"packageManager": "bun@1.3.14",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"neoorm": "./dist/bin/neoorm.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./sql": {
			"types": "./dist/sql/index.d.ts",
			"default": "./dist/sql/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"default": "./dist/plugins/index.js"
		},
		"./plugins/postgis": {
			"types": "./dist/plugins/postgis/index.d.ts",
			"default": "./dist/plugins/postgis/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"schema": [
				"dist/schema/index.d.ts"
			],
			"sql": [
				"dist/sql/index.d.ts"
			],
			"plugins": [
				"dist/plugins/index.d.ts"
			],
			"plugins/postgis": [
				"dist/plugins/postgis/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"orm",
		"postgresql",
		"postgres",
		"sqlite",
		"mysql",
		"mariadb",
		"typescript",
		"schema",
		"codegen",
		"database"
	],
	"engines": {
		"node": ">=22.5.0"
	},
	"scripts": {
		"build": "bunx tsc -p tsconfig.build.json && bun run studio:build",
		"typecheck": "bunx tsc -p tsconfig.json --noEmit && bun run studio:typecheck",
		"studio:build": "bunx vite build --config studio-web/vite.config.ts",
		"studio:typecheck": "bunx tsc -p studio-web/tsconfig.json --noEmit",
		"studio:dev": "bun scripts/studio-dev.ts",
		"dev": "bunx tsc -w -p tsconfig.build.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bunx vitest run",
		"prepublishOnly": "bun run build && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/state": "^6.7.5",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.12",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-virtual": "^3.14.13",
		"@types/node": "^26.1.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@xyflow/react": "^12.11.6",
		"codemirror": "^6.0.2",
		"mariadb": "^3.4.5",
		"mysql2": "^3.15.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"typebox": "^1.3.31",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.9",
		"zod": "^4.1.5"
	},
	"peerDependencies": {
		"elysia": ">=1.2.0",
		"mysql2": ">=3.0.0",
		"mariadb": ">=3.0.0",
		"typebox": "^1.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"elysia": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		},
		"mariadb": {
			"optional": true
		},
		"typebox": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"commander": "^15.0.0",
		"marked": "^15.0.12",
		"pg": "^8.22.0",
		"tsx": "^4.23.0"
	}
}
